# VPS-08 candidate. Install as /etc/systemd/system/mydmsvn-vps.service (root:root 0644).
# Never write secrets to Environment= or EnvironmentFile=.
[Unit]
Description=MyDmsVn net10 Linux HTTP host (Nginx loopback only)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mydmsvn
Group=mydmsvn
WorkingDirectory=/opt/mydmsvn/current
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=MYDMSVN_VPS08_PROXY_MODE=loopback-nginx-v1
Environment=DOTNET_NOLOGO=1
EnvironmentFile=/etc/mydmsvn/runtime.env
LoadCredential=sql_connection_string:/etc/mydmsvn/credentials/sql_connection_string
LoadCredential=jwt_keys:/etc/mydmsvn/credentials/jwt_keys
LoadCredential=proxy_token:/etc/mydmsvn/credentials/proxy_token
ExecStart=/usr/local/libexec/mydmsvn-vps-start
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=40s
KillSignal=SIGTERM
UMask=0077
StateDirectory=mydmsvn
StateDirectoryMode=0700
ReadWritePaths=/var/lib/mydmsvn/audit
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mydmsvn-vps

[Install]
WantedBy=multi-user.target
