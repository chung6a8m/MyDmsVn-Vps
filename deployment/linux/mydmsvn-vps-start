#!/usr/bin/env bash
# VPS-08: local, dedicated service identity only. No xtrace and no secret output.
set -euo pipefail
umask 077
export LC_ALL=C
export PATH=/usr/bin:/bin

fail() { printf 'VPS-08 service admission refused (check private provisioning).\n' >&2; exit 1; }
[[ "$(id -un)" == "mydmsvn" ]] || fail
[[ "${ASPNETCORE_URLS:-}" == "http://127.0.0.1:5080" ]] || fail
[[ "${MYDMSVN_VPS08_PROXY_MODE:-}" == "loopback-nginx-v1" ]] || fail
[[ -z "${ASPNETCORE_FORWARDEDHEADERS_ENABLED:-}" ]] || fail
[[ -n "${CREDENTIALS_DIRECTORY:-}" && -d "$CREDENTIALS_DIRECTORY" ]] || fail
[[ -f /opt/mydmsvn/current/MyDmsVn.Server.AspNetCoreHost.dll ]] || fail

load_credential() {
  local target="$1" name="$2" file value
  file="$CREDENTIALS_DIRECTORY/$name"
  [[ -f "$file" && ! -L "$file" && -r "$file" ]] || fail
  # command substitution strips an optional terminal newline; embedded newlines
  # and CR are rejected to prevent multi-setting/env injection.
  value="$(cat -- "$file")" || fail
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || fail
  printf -v "$target" '%s' "$value"
  export "$target"
}
load_credential MYDMSVN_WEB_SQL_CONNECTION_STRING sql_connection_string
load_credential MYDMSVN_WEB_JWT_KEYS jwt_keys
load_credential MYDMSVN_VPS08_PROXY_TOKEN proxy_token

exec /usr/bin/dotnet /opt/mydmsvn/current/MyDmsVn.Server.AspNetCoreHost.dll
