# /etc/mydmsvn/runtime.env (root:mydmsvn 0640; no credentials in this file).
# Replace placeholders; remove every unused optional WEB6 setting rather than leaving it empty.
MYDMSVN_WEB_ORIGIN=https://__DOMAIN__
MYDMSVN_WEB_JWT_ISSUER=https://__DOMAIN__
MYDMSVN_WEB_JWT_AUDIENCE=mydmsvn-vps08-staging
MYDMSVN_WEB_JWT_ACTIVE_KID=__APPROVED_KID__
MYDMSVN_WEB_OPERATION_MODE=web5
MYDMSVN_WEB_DESKTOP_API=enabled
MYDMSVN_WEB_SUPERUSER_USERNAME=__APPROVED_EXISTING_SUPERUSER__
MYDMSVN_WEB6_RESEND_ELIGIBILITY=receipt-v1
MYDMSVN_WEB6_CANDIDATE_ID=staging-vps08
MYDMSVN_WEB6_CANDIDATE_ROOT=/var/lib/mydmsvn/audit
MYDMSVN_WEB_SECURITY_AUDIT_PATH=/var/lib/mydmsvn/audit/security.jsonl
