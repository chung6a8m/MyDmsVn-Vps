<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(Vps04Server)' != 'true'">net48</TargetFramework>
    <TargetFramework Condition="'$(Vps04Server)' == 'true'">net10.0</TargetFramework>
    <!-- VPS-04A transitional graph: maintain the unchanged net48 lock while Linux targets net10. -->
    <RestorePackagesWithLockFile Condition="'$(Vps04Server)' == 'true'">false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyDmsVn.Server.Application\MyDmsVn.Server.Application.csproj" />
    <ProjectReference Include="..\MyDmsVn.Server.Domain\MyDmsVn.Server.Domain.csproj" />
  </ItemGroup>
</Project>
