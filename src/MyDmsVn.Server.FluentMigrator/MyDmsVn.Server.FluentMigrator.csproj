<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentMigrator" />
  </ItemGroup>
  <ItemGroup>
    <!-- Link original immutable blobs. Never copy or edit historical scripts. -->
    <EmbeddedResource Include="../MyDmsVn.Server.DbMigrator/Scripts/*.sql"
                      LogicalName="MyDmsVn.Server.FluentMigrator.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
