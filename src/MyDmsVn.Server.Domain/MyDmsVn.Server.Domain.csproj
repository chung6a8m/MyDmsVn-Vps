<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(Vps04Server)' != 'true'">net48</TargetFramework>
    <TargetFramework Condition="'$(Vps04Server)' == 'true'">net10.0</TargetFramework>
    <!-- VPS-04A transitional graph: maintain the unchanged net48 lock while Linux targets net10. -->
    <RestorePackagesWithLockFile Condition="'$(Vps04Server)' == 'true'">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(Vps04Server)' == 'true'">$(MSBuildProjectDirectory)/packages.vps04a.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Numerics" Condition="'$(Vps04Server)' != 'true'" />
    <ProjectReference Include="..\MyDmsVn.SharedKernel\MyDmsVn.SharedKernel.csproj" />
  </ItemGroup>
</Project>
