<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)mediator-generated</CompilerGeneratedFilesOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Vps04Server>true</Vps04Server>
    <Vps06bMediator>true</Vps06bMediator>
    <!-- The transitional net10 graph needs its own lock snapshots before locked-mode is enabled. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.vps06b.lock.json</NuGetLockFilePath>
    <DefineConstants>$(DefineConstants);VPS05_STJ_EGRESS;VPS05_STJ_INGRESS;VPS06B_MEDIATOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MyDmsVn.Contracts/MyDmsVn.Contracts.csproj">
      <AdditionalProperties>Vps04Server=true;Vps06bMediator=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../MyDmsVn.Server.Application/MyDmsVn.Server.Application.csproj">
      <AdditionalProperties>Vps04Server=true;Vps06bMediator=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../MyDmsVn.Server.Infrastructure/MyDmsVn.Server.Infrastructure.csproj">
      <AdditionalProperties>Vps04Server=true;Vps06bMediator=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Keep all existing JSON/business handlers byte-identical during the transport replatform. -->
    <Compile Include="../MyDmsVn.Server.HttpHost/*.cs"
             Exclude="../MyDmsVn.Server.HttpHost/Startup.cs;../MyDmsVn.Server.HttpHost/Web2Pipeline.cs;../MyDmsVn.Server.HttpHost/SpaAssets.cs;../MyDmsVn.Server.HttpHost/RequestServices.cs;../MyDmsVn.Server.HttpHost/ProtectedFileSecurityAuditSink.cs;../MyDmsVn.Server.HttpHost/SecurityAuditReadiness.cs;../MyDmsVn.Server.HttpHost/HttpJson.cs"
             Link="Legacy/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
