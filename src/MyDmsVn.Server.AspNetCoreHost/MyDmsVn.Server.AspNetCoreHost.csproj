<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Vps04Server>true</Vps04Server>
    <!-- The transitional net10 graph needs its own lock snapshots before locked-mode is enabled. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/vps04a.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MyDmsVn.Contracts/MyDmsVn.Contracts.csproj">
      <AdditionalProperties>Vps04Server=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../MyDmsVn.Server.Application/MyDmsVn.Server.Application.csproj">
      <AdditionalProperties>Vps04Server=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../MyDmsVn.Server.Infrastructure/MyDmsVn.Server.Infrastructure.csproj">
      <AdditionalProperties>Vps04Server=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Keep all existing JSON/business handlers byte-identical during the transport replatform. -->
    <Compile Include="../MyDmsVn.Server.HttpHost/*.cs"
             Exclude="../MyDmsVn.Server.HttpHost/Startup.cs;../MyDmsVn.Server.HttpHost/Web2Pipeline.cs;../MyDmsVn.Server.HttpHost/SpaAssets.cs;../MyDmsVn.Server.HttpHost/RequestServices.cs;../MyDmsVn.Server.HttpHost/ProtectedFileSecurityAuditSink.cs;../MyDmsVn.Server.HttpHost/SecurityAuditReadiness.cs"
             Link="Legacy/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
