<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(Vps04Server)' != 'true'">net48</TargetFramework>
    <TargetFramework Condition="'$(Vps04Server)' == 'true'">net10.0</TargetFramework>
    <!-- VPS-04A transitional graph: maintain the unchanged net48 lock while Linux targets net10. -->
    <RestorePackagesWithLockFile Condition="'$(Vps04Server)' == 'true'">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(Vps04Server)' == 'true' and '$(Vps06bMediator)' != 'true'">$(MSBuildProjectDirectory)/packages.vps04a.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(Vps04Server)' == 'true' and '$(Vps06bMediator)' == 'true'">$(MSBuildProjectDirectory)/packages.vps06b.lock.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(Vps06bMediator)' == 'true'">$(DefineConstants);VPS06B_MEDIATOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" Condition="'$(Vps06bMediator)' != 'true'" />
    <PackageReference Include="Mediator.Abstractions" Condition="'$(Vps06bMediator)' == 'true'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" Condition="'$(Vps04Server)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyDmsVn.Contracts\MyDmsVn.Contracts.csproj" />
    <ProjectReference Include="..\MyDmsVn.Server.Domain\MyDmsVn.Server.Domain.csproj" />
  </ItemGroup>
</Project>
