    <TargetFramework>net10.0</TargetFramework>
    <Vps04Server>true</Vps04Server>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="9.0.13" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/MyDmsVn.Server.DbMigrator/Scripts/*.sql"
      LogicalName="MyDmsVn.Vps07b.SqlOracle.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
