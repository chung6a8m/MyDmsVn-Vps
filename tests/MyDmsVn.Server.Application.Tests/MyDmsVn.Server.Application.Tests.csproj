<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(Vps04Server)' != 'true'">net48</TargetFramework>
    <TargetFramework Condition="'$(Vps04Server)' == 'true'">net10.0</TargetFramework>
    <NuGetLockFilePath Condition="'$(Vps04Server)' == 'true'">$(MSBuildProjectDirectory)/obj/vps04a.packages.lock.json</NuGetLockFilePath>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyDmsVn.Contracts\MyDmsVn.Contracts.csproj" />
    <ProjectReference Include="..\..\src\MyDmsVn.Server.Application\MyDmsVn.Server.Application.csproj" />
  </ItemGroup>
</Project>
