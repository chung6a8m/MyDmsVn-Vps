<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Vps04Server>true</Vps04Server>
    <Vps06bMediator>true</Vps06bMediator>
    <!-- Live tests are absent from normal CI/discovery; explicit opt-in on approved SQL only. -->
    <DefineConstants Condition="'$(Vps04ALive)' == 'true'">$(DefineConstants);VPS04A_LIVE</DefineConstants>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.vps06b.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Independent legacy Json.NET differential oracle belongs only to tests,
         never to the published Linux net10 Host graph. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MyDmsVn.Server.AspNetCoreHost/MyDmsVn.Server.AspNetCoreHost.csproj" />
  </ItemGroup>
</Project>
