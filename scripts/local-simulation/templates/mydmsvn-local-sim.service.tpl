[Unit]
Description=MyDmsVn local simulation net10 host
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mydmsvn-local-sim
Group=mydmsvn-local-sim
WorkingDirectory=/opt/mydmsvn-local-sim/current
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=MYDMSVN_VPS08_PROXY_MODE=loopback-nginx-v1
Environment=DOTNET_NOLOGO=1
EnvironmentFile=/etc/mydmsvn-local-sim/runtime.env
LoadCredential=sql_connection_string:/etc/mydmsvn-local-sim/credentials/sql_connection_string
LoadCredential=jwt_keys:/etc/mydmsvn-local-sim/credentials/jwt_keys
LoadCredential=proxy_token:/etc/mydmsvn-local-sim/credentials/proxy_token
ExecStart=/usr/local/libexec/mydmsvn-local-sim-start
Restart=on-failure
RestartSec=3s
TimeoutStartSec=45s
TimeoutStopSec=40s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/mydmsvn-local-sim/audit
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mydmsvn-local-sim

[Install]
WantedBy=multi-user.target
