#!/usr/bin/env bash
set -euo pipefail
umask 077
export LC_ALL=C
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
TEMPLATES="$SCRIPT_DIR/templates"

fail() { printf '%s\n' "$1" >&2; exit 2; }
regular_dir() { [[ -d "$1" && ! -L "$1" ]] || fail 'LocalSimulation.DirectoryInvalid'; }
regular_file() { [[ -f "$1" && ! -L "$1" ]] || fail 'LocalSimulation.FileInvalid'; }

read_setting() {
  local file="$1" key="$2" count value
  count="$(awk -F= -v key="$key" '$1==key { count++ } END { print count+0 }' "$file")"
  [[ "$count" == 1 ]] || fail "LocalSimulation.SettingInvalid.${key}"
  value="$(awk -F= -v key="$key" '$1==key { sub(/\r$/,""); sub(/^[^=]*=/,""); print }' "$file")"
  [[ "$value" =~ ^[^[:space:]]+$ ]] || fail "LocalSimulation.SettingInvalid.${key}"
  printf '%s' "$value"
}

load_instance() {
  local state="$1" file
  regular_dir "$state"
  file="$state/instance.env"
  regular_file "$file"
  INSTANCE_ID="$(read_setting "$file" INSTANCE_ID)"
  SOURCE_SHA="$(read_setting "$file" SOURCE_SHA)"
  RELEASE_ID="$(read_setting "$file" RELEASE_ID)"
  PUBLIC_ORIGIN="$(read_setting "$file" PUBLIC_ORIGIN)"
  SQL_SERVER="$(read_setting "$file" SQL_SERVER)"
  [[ "$INSTANCE_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || fail 'LocalSimulation.InstanceInvalid'
  [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'LocalSimulation.SourceShaInvalid'
  [[ "$RELEASE_ID" =~ ^[0-9a-f]{40}$ ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
  [[ "$PUBLIC_ORIGIN" == 'https://localhost:50443' ]] || fail 'LocalSimulation.OriginInvalid'
  [[ "$SQL_SERVER" == '127.0.0.1,11433' ]] || fail 'LocalSimulation.SqlServerInvalid'
}

render() {
  [[ $# == 3 ]] || fail 'LocalSimulation.RenderArgumentsInvalid'
  local state="$1" output="$2" publish="$3" secret
  load_instance "$state"
  regular_dir "$publish"
  regular_file "$publish/MyDmsVn.Server.AspNetCoreHost.dll"
  [[ ! -e "$output" ]] || fail 'LocalSimulation.RenderOutputExists'
  for secret in proxy_token jwt_keys sql_connection_string; do regular_file "$state/secrets/$secret"; done
  for secret in ca.crt nginx.crt nginx.key; do regular_file "$state/tls/$secret"; done
  mkdir -m 0700 -- "$output"
  install -m 0644 "$TEMPLATES/mydmsvn-local-sim.service.tpl" "$output/mydmsvn-local-sim.service"
  install -m 0755 "$TEMPLATES/mydmsvn-local-sim-start.tpl" "$output/mydmsvn-local-sim-start"
  install -m 0644 "$TEMPLATES/mydmsvn-local-sim.nginx.conf.tpl" "$output/mydmsvn-local-sim.nginx.conf"
  cat >"$output/runtime.env" <<EOF
MYDMSVN_WEB_ORIGIN=https://localhost:50443
MYDMSVN_WEB_JWT_ISSUER=https://localhost:50443
MYDMSVN_WEB_JWT_AUDIENCE=mydmsvn-local-simulation
MYDMSVN_WEB_JWT_ACTIVE_KID=local-key
MYDMSVN_WEB_OPERATION_MODE=web5
MYDMSVN_WEB_DESKTOP_API=enabled
MYDMSVN_WEB_SUPERUSER_USERNAME=local_sim_writer
MYDMSVN_WEB6_RESEND_ELIGIBILITY=receipt-v1
MYDMSVN_WEB6_CANDIDATE_ID=local-simulation
MYDMSVN_WEB6_CANDIDATE_ROOT=/var/lib/mydmsvn-local-sim/audit
MYDMSVN_WEB_SECURITY_AUDIT_PATH=/var/lib/mydmsvn-local-sim/audit/security.jsonl
EOF
  chmod 0640 "$output/runtime.env"
  printf '{"schemaVersion":1,"status":"RENDERED","instanceId":"%s","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n' "$INSTANCE_ID"
}

certificates() {
  [[ $# == 2 && "$2" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || fail 'LocalSimulation.CertificateArgumentsInvalid'
  local state="$1" instance="$2" tls="$1/tls"
  regular_dir "$state"
  regular_dir "$tls"
  [[ -z "$(find "$tls" -mindepth 1 -maxdepth 1 -print -quit)" ]] || fail 'LocalSimulation.CertificateOutputExists'
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$tls/ca.key" >/dev/null 2>&1
  openssl req -x509 -new -sha256 -days 30 -key "$tls/ca.key" -subj "/CN=MyDmsVn Local Sim $instance" -out "$tls/ca.crt" >/dev/null 2>&1
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$tls/sql.key" >/dev/null 2>&1
  openssl req -new -key "$tls/sql.key" -subj '/CN=localhost' -out "$tls/sql.csr" >/dev/null 2>&1
  printf 'subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n' >"$tls/sql.ext"
  openssl x509 -req -sha256 -days 30 -in "$tls/sql.csr" -CA "$tls/ca.crt" -CAkey "$tls/ca.key" -CAcreateserial -extfile "$tls/sql.ext" -out "$tls/sql.crt" >/dev/null 2>&1
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$tls/nginx.key" >/dev/null 2>&1
  openssl req -new -key "$tls/nginx.key" -subj '/CN=localhost' -out "$tls/nginx.csr" >/dev/null 2>&1
  printf 'subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n' >"$tls/nginx.ext"
  openssl x509 -req -sha256 -days 30 -in "$tls/nginx.csr" -CA "$tls/ca.crt" -CAkey "$tls/ca.key" -CAcreateserial -extfile "$tls/nginx.ext" -out "$tls/nginx.crt" >/dev/null 2>&1
  chmod 0600 "$tls"/*.key
  chmod 0644 "$tls"/*.crt
  printf '{"schemaVersion":1,"status":"CERTIFICATES_CREATED","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n'
}

admit_lab() {
  [[ "$(id -u)" == 0 ]] || fail 'LocalSimulation.RootRequired'
  id mydmsvn-local-sim >/dev/null 2>&1 && fail 'LocalSimulation.UserCollision'
  local path
  for path in /opt/mydmsvn-local-sim /etc/mydmsvn-local-sim /var/lib/mydmsvn-local-sim \
    /etc/systemd/system/mydmsvn-local-sim.service /usr/local/libexec/mydmsvn-local-sim-start \
    /etc/nginx/sites-enabled/mydmsvn-local-sim /etc/nginx/sites-available/mydmsvn-local-sim \
    /etc/nginx/mydmsvn-local-sim-proxy-token.conf /usr/local/share/ca-certificates/mydmsvn-local-sim-ca.crt; do
    [[ ! -e "$path" && ! -L "$path" ]] || fail 'LocalSimulation.WslResourceCollision'
  done
}

protect_installation_tree() {
  local root="$1"
  regular_dir "$root"
  [[ -z "$(find "$root" ! -type f ! -type d -print -quit)" ]] ||
    fail 'LocalSimulation.ArtifactIdentityMismatch'
  find "$root" -type d -exec chmod 0755 -- '{}' +
  find "$root" -type f -exec chmod 0644 -- '{}' +
}

install_lab() {
  [[ $# == 4 ]] || fail 'LocalSimulation.InstallArgumentsInvalid'
  [[ "$(id -u)" == 0 ]] || fail 'LocalSimulation.RootRequired'
  local state="$1" rendered="$2" publish="$3" requested="$4" secret
  load_instance "$state"
  [[ "$requested" == "$INSTANCE_ID" ]] || fail 'LocalSimulation.InstanceMismatch'
  regular_dir "$rendered"; regular_dir "$publish"
  regular_dir "$state/runtime"
  admit_lab
  command -v nginx >/dev/null || fail 'LocalSimulation.NginxMissing'
  [[ -x "$state/runtime/dotnet" ]] || fail 'LocalSimulation.AspNetRuntimeMissing'
  install -d -o root -g root -m 0700 /etc/mydmsvn-local-sim
  printf '%s\n' "$INSTANCE_ID" >/etc/mydmsvn-local-sim/instance-id
  printf '%s\n' "$SOURCE_SHA" >/etc/mydmsvn-local-sim/source-sha
  chmod 0600 /etc/mydmsvn-local-sim/instance-id /etc/mydmsvn-local-sim/source-sha
  useradd --system --no-create-home --shell /usr/sbin/nologin mydmsvn-local-sim
  install -d -o root -g root -m 0755 /opt/mydmsvn-local-sim /opt/mydmsvn-local-sim/releases /usr/local/libexec
  install -d -o root -g root -m 0700 /opt/mydmsvn-local-sim/runtime
  cp -R --no-preserve=ownership,mode -- "$state/runtime/." /opt/mydmsvn-local-sim/runtime/
  protect_installation_tree /opt/mydmsvn-local-sim/runtime
  chmod 0755 -- /opt/mydmsvn-local-sim/runtime/dotnet
  find /opt/mydmsvn-local-sim/runtime/shared -name createdump -type f -exec chmod 0755 -- '{}' +
  install -d -o root -g root -m 0700 /etc/mydmsvn-local-sim/credentials /etc/mydmsvn-local-sim/tls
  install -d -o mydmsvn-local-sim -g mydmsvn-local-sim -m 0700 /var/lib/mydmsvn-local-sim /var/lib/mydmsvn-local-sim/audit
  install -o mydmsvn-local-sim -g mydmsvn-local-sim -m 0600 /dev/null /var/lib/mydmsvn-local-sim/audit/security.jsonl
  [[ ! -e "/opt/mydmsvn-local-sim/releases/$RELEASE_ID" ]] || fail 'LocalSimulation.ReleaseExists'
  install -d -o root -g root -m 0700 "/opt/mydmsvn-local-sim/releases/$RELEASE_ID"
  cp -R --no-preserve=ownership,mode -- "$publish/." "/opt/mydmsvn-local-sim/releases/$RELEASE_ID/"
  protect_installation_tree "/opt/mydmsvn-local-sim/releases/$RELEASE_ID"
  ln -sfn "releases/$RELEASE_ID" /opt/mydmsvn-local-sim/current
  install -o root -g root -m 0644 "$rendered/mydmsvn-local-sim.service" /etc/systemd/system/mydmsvn-local-sim.service
  install -o root -g root -m 0755 "$rendered/mydmsvn-local-sim-start" /usr/local/libexec/mydmsvn-local-sim-start
  install -o root -g mydmsvn-local-sim -m 0640 "$rendered/runtime.env" /etc/mydmsvn-local-sim/runtime.env
  for secret in proxy_token jwt_keys sql_connection_string; do install -o root -g root -m 0600 "$state/secrets/$secret" "/etc/mydmsvn-local-sim/credentials/$secret"; done
  install -o root -g root -m 0644 "$state/tls/ca.crt" /etc/mydmsvn-local-sim/tls/ca.crt
  install -o root -g root -m 0644 "$state/tls/nginx.crt" /etc/mydmsvn-local-sim/tls/nginx.crt
  install -o root -g root -m 0600 "$state/tls/nginx.key" /etc/mydmsvn-local-sim/tls/nginx.key
  install -o root -g root -m 0644 "$state/tls/ca.crt" /usr/local/share/ca-certificates/mydmsvn-local-sim-ca.crt
  update-ca-certificates >/dev/null
  install -o root -g root -m 0644 "$rendered/mydmsvn-local-sim.nginx.conf" /etc/nginx/sites-available/mydmsvn-local-sim
  ln -sfn /etc/nginx/sites-available/mydmsvn-local-sim /etc/nginx/sites-enabled/mydmsvn-local-sim
  printf 'proxy_set_header X-MyDmsVn-Proxy-Token "%s";\n' "$(cat "$state/secrets/proxy_token")" >/etc/nginx/mydmsvn-local-sim-proxy-token.conf
  chmod 0600 /etc/nginx/mydmsvn-local-sim-proxy-token.conf
  nginx -t >/dev/null
  systemctl daemon-reload
  systemctl enable mydmsvn-local-sim.service >/dev/null
  printf '{"schemaVersion":1,"status":"INSTALLED","instanceId":"%s","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n' "$INSTANCE_ID"
}

install_prerequisites() {
  [[ $# == 1 && "$(id -u)" == 0 ]] || fail 'LocalSimulation.RootRequired'
  local state="$1" runtime_root="$1/runtime" runtime_version=10.0.11 archive work
  regular_dir "$state"
  [[ ! -e "$runtime_root" && ! -L "$runtime_root" ]] || fail 'LocalSimulation.RuntimeStateCollision'
  admit_lab
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl nginx
  if [[ ! -x "$runtime_root/dotnet" || ! -d "$runtime_root/shared/Microsoft.AspNetCore.App/$runtime_version" ]]; then
    work="$(mktemp -d)"; archive="$work/aspnetcore-runtime.tar.gz"
    trap "rm -rf -- '$work'" EXIT
    curl --fail --silent --show-error --location \
      https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.11/aspnetcore-runtime-10.0.11-linux-x64.tar.gz \
      --output "$archive"
    printf '%s  %s\n' \
      '4c6be0623330074e699dab8084be15a1baebb7a518c0dd8ce99f93cf79777cd46f3a38ef9d25edc152ed606f084b63736bd9e4082eb32d188fc357bf6ac4d1d6' \
      "$archive" | sha512sum --check --status || fail 'LocalSimulation.AspNetRuntimeHashMismatch'
    install -d -m 0755 "$runtime_root"
    tar -xzf "$archive" -C "$runtime_root"
    rm -rf -- "$work"; trap - EXIT
  fi
  command -v nginx >/dev/null || fail 'LocalSimulation.NginxMissing'
  "$runtime_root/dotnet" --list-runtimes | grep -q "Microsoft.AspNetCore.App $runtime_version " || fail 'LocalSimulation.AspNetRuntimeMissing'
  printf '{"schemaVersion":1,"status":"PREREQUISITES_READY","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n'
}

verify_candidate_release() {
  local release="$1" digest="$2" line relative
  local manifest="$release/artifact-manifest.txt"
  regular_dir "$release"
  regular_file "$manifest"
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || fail 'LocalSimulation.ArtifactIdentityInvalid'
  [[ "$(sha256sum -- "$manifest" | cut -d ' ' -f 1)" == "$digest" ]] ||
    fail 'LocalSimulation.ArtifactIdentityMismatch'
  [[ -z "$(find "$release" ! -type f ! -type d -print -quit)" ]] ||
    fail 'LocalSimulation.ArtifactIdentityMismatch'
  while IFS= read -r line; do
    [[ "$line" =~ ^[0-9a-f]{64}[[:space:]][[:space:]]([A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)*)$ ]] ||
      fail 'LocalSimulation.ArtifactIdentityMismatch'
    relative="${BASH_REMATCH[1]}"
    [[ ! "$relative" =~ (^|/)\.{1,2}(/|$) && "$relative" != artifact-manifest.txt ]] ||
      fail 'LocalSimulation.ArtifactIdentityMismatch'
  done <"$manifest"
  [[ -s "$manifest" ]] || fail 'LocalSimulation.ArtifactIdentityMismatch'
  diff -u \
    <(cut -c 67- "$manifest" | sort) \
    <(find "$release" -type f ! -path "$manifest" -printf '%P\n' | sort) \
    >/dev/null || fail 'LocalSimulation.ArtifactIdentityMismatch'
  (cd "$release" && sha256sum --strict --check --status artifact-manifest.txt) ||
    fail 'LocalSimulation.ArtifactIdentityMismatch'
}

switch_candidate_release() (
  [[ $# == 5 ]] || fail 'LocalSimulation.UpgradeArgumentsInvalid'
  local root="$1" old="$2" new="$3" old_hash="$4" new_hash="$5" active stage lock_fd
  [[ "$old" =~ ^[0-9a-f]{40}$ && "$new" =~ ^[0-9a-f]{40}$ && "$old" != "$new" ]] ||
    fail 'LocalSimulation.ReleaseIdentityMismatch'
  regular_dir "$root"
  regular_dir "$root/releases"
  local lock="$root/.release-switch.lock"
  if [[ -e "$lock" || -L "$lock" ]]; then regular_file "$lock"; fi
  exec {lock_fd}>"$lock"
  flock -n "$lock_fd" || fail 'LocalSimulation.UpgradeLocked'
  [[ -L "$root/current" ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
  active="$(readlink -- "$root/current")"
  [[ "$active" == "releases/$old" || "$active" == "releases/$new" ]] ||
    fail 'LocalSimulation.ReleaseIdentityMismatch'
  verify_candidate_release "$root/releases/$old" "$old_hash"
  verify_candidate_release "$root/releases/$new" "$new_hash"
  if [[ "$active" == "releases/$new" ]]; then printf '%s\n' ALREADY_ACTIVE; return 0; fi

  stage="$(mktemp -d "$root/.release-switch.XXXXXXXX")"
  trap 'rm -f -- "$stage/current"; rmdir -- "$stage"' EXIT
  ln -s -- "releases/$new" "$stage/current"
  mv -T -- "$stage/current" "$root/current"
  sync -f "$root"
  printf '%s\n' SWITCHED
)

assert_lab_owner() {
  [[ $# == 2 && "$(id -u)" == 0 ]] || fail 'LocalSimulation.IdentityArgumentsInvalid'
  regular_file /etc/mydmsvn-local-sim/instance-id
  [[ "$(cat /etc/mydmsvn-local-sim/instance-id)" == "$1" ]] || fail 'LocalSimulation.InstanceMismatch'
  [[ "$2" =~ ^[0-9a-f]{40}$ ]] || fail 'LocalSimulation.SourceShaInvalid'
  regular_file /etc/mydmsvn-local-sim/source-sha
  [[ "$(cat /etc/mydmsvn-local-sim/source-sha)" == "$2" ]] || fail 'LocalSimulation.SourceShaInvalid'
}

identity_lab() {
  [[ $# == 3 || $# == 4 ]] || fail 'LocalSimulation.IdentityArgumentsInvalid'
  assert_lab_owner "$1" "$2"
  local active="${4:-$2}" root=/opt/mydmsvn-local-sim
  [[ "$active" =~ ^[0-9a-f]{40}$ ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
  regular_dir "$root"; regular_dir "$root/releases"
  [[ -L "$root/current" && "$(readlink "$root/current")" == "releases/$active" ]] ||
    fail 'LocalSimulation.ReleaseIdentityMismatch'
  verify_candidate_release "$root/releases/$active" "$3"
  [[ -z "$(find "$root/releases/$active" \( ! -user root -o -perm /022 \) -print -quit)" ]] ||
    fail 'LocalSimulation.ArtifactIdentityMismatch'
}

assert_upgrade_service() {
  local unit=/etc/systemd/system/mydmsvn-local-sim.service start=/usr/local/libexec/mydmsvn-local-sim-start
  regular_file "$unit"; regular_file "$start"
  [[ "$(sha256sum -- "$unit" | cut -d ' ' -f 1)" == "$1" &&
     "$(sha256sum -- "$start" | cut -d ' ' -f 1)" == "$2" ]] ||
    fail 'LocalSimulation.UpgradeServiceMismatch'
  [[ "$(systemctl show mydmsvn-local-sim.service --property=FragmentPath --value)" == "$unit" &&
     -z "$(systemctl show mydmsvn-local-sim.service --property=DropInPaths --value)" &&
     "$(systemctl show mydmsvn-local-sim.service --property=User --value)" == mydmsvn-local-sim ]] ||
    fail 'LocalSimulation.UpgradeServiceMismatch'
}

observe_upgrade_lab() {
  [[ $# == 7 ]] || fail 'LocalSimulation.UpgradeArgumentsInvalid'
  local instance="$1" tooling="$2" release="$3" hash="$4" unit="$5" start="$6" prefix="$7"
  identity_lab "$instance" "$tooling" "$hash" "$release"
  assert_upgrade_service "$unit" "$start"
  local pid audit=/var/lib/mydmsvn-local-sim/audit/security.jsonl size identities prefix_hash
  pid="$(systemctl show mydmsvn-local-sim.service --property=MainPID --value)"
  regular_file "$audit"
  [[ "$(stat -c '%a:%U' "$audit")" == '600:mydmsvn-local-sim' ]] || fail 'LocalSimulation.UpgradeAuditMismatch'
  size="$(stat -c '%s' "$audit")"
  [[ "$pid" =~ ^[0-9]+$ && "$size" =~ ^[0-9]+$ ]] || fail 'LocalSimulation.UpgradeIdentityUnavailable'
  if [[ "$pid" != 0 ]]; then
    local -a argv
    mapfile -d '' -t argv <"/proc/$pid/cmdline"
    [[ "${#argv[@]}" == 2 && "${argv[0]}" == /opt/mydmsvn-local-sim/runtime/dotnet &&
       "${argv[1]}" == /opt/mydmsvn-local-sim/current/MyDmsVn.Server.AspNetCoreHost.dll ]] ||
      fail 'LocalSimulation.UpgradeProcessMismatch'
    [[ "$(readlink -f -- "/proc/$pid/cwd")" == "/opt/mydmsvn-local-sim/releases/$release" &&
       "$(readlink -f -- "/proc/$pid/exe")" == /opt/mydmsvn-local-sim/runtime/dotnet ]] ||
      fail 'LocalSimulation.UpgradeProcessMismatch'
  fi
  if [[ "$prefix" == current ]]; then prefix="$size"; fi
  [[ "$prefix" =~ ^[0-9]{1,12}$ && "$prefix" -le "$size" ]] || fail 'LocalSimulation.UpgradeAuditMismatch'
  prefix_hash="$(head -c "$prefix" -- "$audit" | sha256sum | cut -d ' ' -f 1)"
  identities="$(
    regular_file /etc/mydmsvn-local-sim/credentials/jwt_keys
    regular_file /etc/mydmsvn-local-sim/credentials/proxy_token
    regular_file /etc/mydmsvn-local-sim/credentials/sql_connection_string
    regular_file /etc/mydmsvn-local-sim/runtime.env
    regular_file /etc/mydmsvn-local-sim/tls/ca.crt
    regular_file /etc/mydmsvn-local-sim/tls/nginx.crt
    printf '%s\n' "$instance"
    sha256sum /etc/mydmsvn-local-sim/credentials/{jwt_keys,proxy_token,sql_connection_string} \
      /etc/mydmsvn-local-sim/runtime.env /etc/mydmsvn-local-sim/tls/{ca.crt,nginx.crt}
    stat -c '%d:%i:%a:%U' "$(dirname -- "$audit")" "$audit"
  )" || fail 'LocalSimulation.UpgradeIdentityUnavailable'
  identities="$(printf '%s' "$identities" | sha256sum | cut -d ' ' -f 1)"
  printf '{"pid":%d,"auditSize":%d,"auditPrefixSha256":"%s","continuitySha256":"%s"}\n' \
    "$pid" "$size" "$prefix_hash" "$identities"
}

current_upgrade_release() {
  [[ $# == 4 ]] || fail 'LocalSimulation.UpgradeArgumentsInvalid'
  assert_lab_owner "$1" "$2"
  local root=/opt/mydmsvn-local-sim active
  regular_dir "$root"; regular_dir "$root/releases"
  [[ -L "$root/current" ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
  active="$(readlink -- "$root/current")"
  [[ "$active" == "releases/$3" || "$active" == "releases/$4" ]] ||
    fail 'LocalSimulation.ReleaseIdentityMismatch'
  printf '%s\n' "${active#releases/}"
}

with_upgrade_lock() (
  local operation="$1"; shift
  assert_lab_owner "$1" "$2"
  local directory=/etc/mydmsvn-local-sim lock_fd
  regular_dir "$directory"
  local lock="$directory/.upgrade-operation.lock"
  if [[ -e "$lock" || -L "$lock" ]]; then regular_file "$lock"; fi
  exec {lock_fd}>"$lock"
  flock -n "$lock_fd" || fail 'LocalSimulation.UpgradeLocked'
  "$operation" "$@"
)

record_upgrade_intent() {
  local base="$1" id="$2" action="$3" from="$4" to="$5" state payload temporary
  [[ "$id" =~ ^[0-9a-f]{32}$ && ( "$action" == Upgrade || "$action" == RollbackUpgrade ) ]] ||
    fail 'LocalSimulation.UpgradeArgumentsInvalid'
  regular_dir "$base"
  state="$base/$id"
  if [[ -e "$state" || -L "$state" ]]; then
    regular_file "$state"
    payload="$(cat -- "$state")"
    if [[ "$payload" == "RollbackUpgrade $from $to" && "$action" == Upgrade ]]; then
      fail 'LocalSimulation.UpgradeIntentCancelled'
    fi
    [[ "$payload" == "Upgrade $from $to" || "$payload" == "RollbackUpgrade $from $to" ]] ||
      fail 'LocalSimulation.UpgradeJournalMismatch'
    [[ "$payload" != "$action $from $to" ]] || return 0
  fi
  temporary="$(mktemp "$base/.intent.XXXXXXXX")"
  printf '%s %s %s\n' "$action" "$from" "$to" >"$temporary"
  mv -T -- "$temporary" "$state"
  sync -f "$base"
}

activate_upgrade_lab() {
  [[ $# == 11 ]] || fail 'LocalSimulation.UpgradeArgumentsInvalid'
  local instance="$1" tooling="$2" old="$3" new="$4" old_hash="$5" new_hash="$6" publish="$7" unit="$8" start="$9"
  local root=/opt/mydmsvn-local-sim active stage action="${10}" request="${11}"
  assert_lab_owner "$instance" "$tooling"
  assert_upgrade_service "$unit" "$start"
  [[ "$old" =~ ^[0-9a-f]{40}$ && "$new" =~ ^[0-9a-f]{40}$ && "$old" != "$new" ]] ||
    fail 'LocalSimulation.ReleaseIdentityMismatch'
  regular_dir "$root"; regular_dir "$root/releases"
  [[ -L "$root/current" ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
  active="$(readlink -- "$root/current")"
  [[ "$active" == "releases/$old" || "$active" == "releases/$new" ]] ||
    fail 'LocalSimulation.ReleaseIdentityMismatch'
  local intent=/etc/mydmsvn-local-sim/upgrade-intents
  if [[ ! -e "$intent" && ! -L "$intent" ]]; then install -d -o root -g root -m 0700 "$intent"; fi
  if [[ "$action" == RollbackUpgrade ]]; then
    record_upgrade_intent "$intent" "$request" "$action" "$new:$new_hash" "$old:$old_hash"
  else
    record_upgrade_intent "$intent" "$request" "$action" "$old:$old_hash" "$new:$new_hash"
  fi
  if [[ "$active" == "releases/$old" ]]; then verify_candidate_release "$root/releases/$old" "$old_hash"; fi
  if [[ ! -e "$root/releases/$new" && ! -L "$root/releases/$new" ]]; then
    [[ "$active" == "releases/$old" && "$publish" != '-' ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
    verify_candidate_release "$publish" "$new_hash"
    stage="$(mktemp -d "$root/releases/.staged-$new.XXXXXXXX")"
    cp -R --no-preserve=ownership,mode -- "$publish/." "$stage/"
    verify_candidate_release "$stage" "$new_hash"
    chmod 0755 -- "$stage"
    find "$stage" -type d -exec chmod 0755 -- '{}' +
    find "$stage" -type f -exec chmod 0644 -- '{}' +
    mv -T --no-clobber -- "$stage" "$root/releases/$new"
    sync -f "$root/releases"
  fi
  verify_candidate_release "$root/releases/$new" "$new_hash"
  if [[ "$active" == "releases/$old" ]]; then
    systemctl stop mydmsvn-local-sim.service
    switch_candidate_release "$root" "$old" "$new" "$old_hash" "$new_hash" >/dev/null
  fi
  if ! systemctl is-active --quiet mydmsvn-local-sim.service; then
    systemctl reset-failed mydmsvn-local-sim.service
    systemctl start mydmsvn-local-sim.service
  fi
  verify_lab "$instance" "$tooling" "$new_hash" "$new" >/dev/null
  observe_upgrade_lab "$instance" "$tooling" "$new" "$new_hash" "$unit" "$start" current
}

start_lab() {
  identity_lab "$@"
  systemctl reset-failed mydmsvn-local-sim.service
  systemctl restart mydmsvn-local-sim.service
  systemctl reload nginx
}

stop_lab() {
  identity_lab "$@"
  systemctl stop mydmsvn-local-sim.service
}

verify_lab() {
  identity_lab "$@"
  local direct ready=0
  for _ in $(seq 1 30); do
    if systemctl is-active --quiet mydmsvn-local-sim.service && \
      curl --fail --silent --max-time 3 --cacert /etc/mydmsvn-local-sim/tls/ca.crt https://localhost:50443/api/v1/health >/dev/null 2>&1; then
      ready=1; break
    fi
    sleep 1
  done
  [[ "$ready" == 1 ]] || fail 'LocalSimulation.HttpsHealthFailed'
  direct="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 4 -H 'Host: localhost:50443' http://127.0.0.1:5080/api/v1/health || true)"
  [[ "$direct" == 400 ]] || fail 'LocalSimulation.DirectKestrelAdmissionFailed'
  local wrong_host
  wrong_host="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 4 --cacert /etc/mydmsvn-local-sim/tls/ca.crt -H 'Host: wrong.invalid:50443' https://localhost:50443/api/v1/health || true)"
  [[ "$wrong_host" == 000 ]] || fail 'LocalSimulation.NginxHostAdmissionFailed'
  printf '{"schemaVersion":1,"status":"VERIFIED","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n'
}

recovery_drill() {
  identity_lab "$@"
  systemctl reset-failed mydmsvn-local-sim.service
  systemctl restart mydmsvn-local-sim.service
  local before current recovered=0 https=0
  before="$(systemctl show mydmsvn-local-sim.service --property=MainPID --value)"
  [[ "$before" =~ ^[1-9][0-9]*$ ]] || fail 'LocalSimulation.RecoveryPidMissing'
  systemctl kill --kill-who=main --signal=SIGKILL mydmsvn-local-sim.service
  for _ in $(seq 1 30); do
    current="$(systemctl show mydmsvn-local-sim.service --property=MainPID --value)"
    if systemctl is-active --quiet mydmsvn-local-sim.service && \
      [[ "$current" =~ ^[1-9][0-9]*$ && "$current" != "$before" ]]; then
      recovered=1
      if curl --fail --silent --max-time 3 --cacert /etc/mydmsvn-local-sim/tls/ca.crt https://localhost:50443/api/v1/health >/dev/null 2>&1; then
        https=1; break
      fi
    fi
    sleep 1
  done
  recovery_result "$recovered" "$https"
}

recovery_result() {
  [[ $# == 2 && "$1" =~ ^[01]$ && "$2" =~ ^[01]$ ]] || fail 'LocalSimulation.RecoveryArgumentsInvalid'
  if [[ "$1" == 1 && "$2" == 1 ]]; then
    printf '{"schemaVersion":1,"status":"RECOVERED","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n'; return 0
  fi
  printf '{"schemaVersion":1,"status":"FAILED","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n'; return 1
}

reset_admission() {
  [[ ( $# == 2 || $# == 3 ) && "$(id -u)" == 0 ]] || fail 'LocalSimulation.ResetArgumentsInvalid'
  local requested="$1" source="$2" release="${3:-$2}" path
  [[ "$source" =~ ^[0-9a-f]{40}$ ]] || fail 'LocalSimulation.SourceShaInvalid'
  if [[ ! -e /etc/mydmsvn-local-sim/instance-id && ! -L /etc/mydmsvn-local-sim/instance-id ]]; then
    id mydmsvn-local-sim >/dev/null 2>&1 && fail 'LocalSimulation.WslIdentityMissing'
    for path in /opt/mydmsvn-local-sim /etc/mydmsvn-local-sim /var/lib/mydmsvn-local-sim \
      /etc/systemd/system/mydmsvn-local-sim.service /usr/local/libexec/mydmsvn-local-sim-start \
      /etc/nginx/sites-enabled/mydmsvn-local-sim /etc/nginx/sites-available/mydmsvn-local-sim \
      /etc/nginx/mydmsvn-local-sim-proxy-token.conf /usr/local/share/ca-certificates/mydmsvn-local-sim-ca.crt; do
      [[ ! -e "$path" && ! -L "$path" ]] || fail 'LocalSimulation.WslIdentityMissing'
    done
    return 0
  fi
  regular_file /etc/mydmsvn-local-sim/instance-id
  [[ "$(cat /etc/mydmsvn-local-sim/instance-id)" == "$requested" ]] || fail 'LocalSimulation.InstanceMismatch'
  regular_file /etc/mydmsvn-local-sim/source-sha
  [[ "$(cat /etc/mydmsvn-local-sim/source-sha)" == "$source" ]] || fail 'LocalSimulation.SourceShaInvalid'
  if [[ -e /opt/mydmsvn-local-sim/current || -L /opt/mydmsvn-local-sim/current ]]; then
    [[ -L /opt/mydmsvn-local-sim/current && "$(readlink /opt/mydmsvn-local-sim/current)" == "releases/$release" ]] || fail 'LocalSimulation.ReleaseIdentityMismatch'
  fi
}

reload_nginx_after_reset() {
  nginx -t >/dev/null || fail 'LocalSimulation.NginxValidationFailed'
  if systemctl is-active --quiet nginx; then
    systemctl reload nginx || fail 'LocalSimulation.NginxReloadFailed'
  fi
}

reset_lab() {
  reset_admission "$@"
  [[ -e /etc/mydmsvn-local-sim/instance-id ]] || return 0
  systemctl disable --now mydmsvn-local-sim.service >/dev/null 2>&1 || {
    systemctl is-active --quiet mydmsvn-local-sim.service && fail 'LocalSimulation.ServiceStopFailed'
  }
  systemctl is-active --quiet mydmsvn-local-sim.service && fail 'LocalSimulation.ServiceStopFailed'
  rm -f -- /etc/systemd/system/mydmsvn-local-sim.service /usr/local/libexec/mydmsvn-local-sim-start
  rm -f -- /etc/nginx/sites-enabled/mydmsvn-local-sim /etc/nginx/sites-available/mydmsvn-local-sim /etc/nginx/mydmsvn-local-sim-proxy-token.conf
  rm -f -- /usr/local/share/ca-certificates/mydmsvn-local-sim-ca.crt
  update-ca-certificates --fresh >/dev/null
  rm -rf -- /opt/mydmsvn-local-sim /var/lib/mydmsvn-local-sim
  if id mydmsvn-local-sim >/dev/null 2>&1; then
    userdel mydmsvn-local-sim >/dev/null 2>&1 || fail 'LocalSimulation.UserRemoveFailed'
  fi
  id mydmsvn-local-sim >/dev/null 2>&1 && fail 'LocalSimulation.UserRemoveFailed'
  systemctl daemon-reload
  reload_nginx_after_reset
  [[ ! -e /opt/mydmsvn-local-sim && ! -e /var/lib/mydmsvn-local-sim && \
     ! -e /etc/systemd/system/mydmsvn-local-sim.service && \
     ! -e /etc/nginx/sites-enabled/mydmsvn-local-sim && \
     ! -e /etc/nginx/sites-available/mydmsvn-local-sim && \
     ! -e /etc/nginx/mydmsvn-local-sim-proxy-token.conf && \
     ! -e /usr/local/share/ca-certificates/mydmsvn-local-sim-ca.crt ]] || fail 'LocalSimulation.ResetPostconditionFailed'
  rm -rf -- /etc/mydmsvn-local-sim
}

reset_sandbox() {
  [[ $# == 2 ]] || fail 'LocalSimulation.SandboxResetArgumentsInvalid'
  local target="$1" requested="$2" resolved parent marker
  regular_dir "$target"; regular_file "$target/instance-id"
  resolved="$(realpath -- "$target")"; parent="$(basename -- "$resolved")"
  [[ "$parent" == mydmsvn-local-sim-* ]] || fail 'LocalSimulation.SandboxTargetRefused'
  marker="$(cat "$target/instance-id")"; [[ "$marker" == "$requested" ]] || fail 'LocalSimulation.InstanceMismatch'
  rm -rf --one-file-system -- "$resolved"
  printf '{"schemaVersion":1,"status":"RESET","notice":"LOCAL SIMULATION - NOT VPS-08/09 ACCEPTANCE"}\n'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  command="${1:-}"; shift || true
  case "$command" in
    render) render "$@" ;;
    certificates) certificates "$@" ;;
    prerequisites) install_prerequisites "$@" ;;
    install) install_lab "$@" ;;
    start) start_lab "$@" ;;
    stop) stop_lab "$@" ;;
    verify) verify_lab "$@" ;;
    recovery) recovery_drill "$@" ;;
    recovery-result) recovery_result "$@" ;;
    reset-admission) reset_admission "$@" ;;
    reset) reset_lab "$@" ;;
    reset-sandbox) reset_sandbox "$@" ;;
    identity) identity_lab "$@" ;;
    upgrade-observe) with_upgrade_lock observe_upgrade_lab "$@" ;;
    upgrade-current) with_upgrade_lock current_upgrade_release "$@" ;;
    upgrade-activate) with_upgrade_lock activate_upgrade_lab "$@" ;;
    *) fail 'LocalSimulation.CommandInvalid' ;;
  esac
fi
